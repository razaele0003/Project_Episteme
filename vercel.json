{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "dist",
  "functions": {
    "api/index.py": {
      "maxDuration": 300,
      "excludeFiles": "{.venv/**,node_modules/**,tests/**,tmp/**,data/**,.env*,*.log,.git/**}"
    }
  },
  "rewrites": [
    {"source": "/api/:path*", "destination": "/api/index"},
    {"source": "/curriculum/:path*", "destination": "/api/index"},
    {"source": "/learning-method", "destination": "/api/index"},
    {"source": "/about", "destination": "/api/index"},
    {"source": "/sitemap.xml", "destination": "/api/index"},
    {"source": "/robots.txt", "destination": "/api/index"}
  ],
  "headers": [{"source": "/(.*)", "headers": [
    {"key": "X-Content-Type-Options", "value": "nosniff"},
    {"key": "X-Frame-Options", "value": "DENY"},
    {"key": "Referrer-Policy", "value": "no-referrer"}
  ]}]
}
