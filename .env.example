# Local personal workspace is the default. Never reverse-proxy local mode publicly.
EPISTEME_MODE=local
# Public mode requires your actual HTTPS domain; do not assume this example is owned.
# PUBLIC_SITE_URL=https://your-owned-domain.example
# EPISTEME_DB=data/progress.sqlite3
# Optional, local workspace only. Use minimal read-only contents permission.
# GITHUB_TOKEN=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_WEBHOOK_SECRET=
